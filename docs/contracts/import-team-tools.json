  "dnspyEvidence": {
    "required": true,
    "record": "docs/exe-golden/FormWarehouseUpload.md",
    "source": "ExcelLoadingPackingList.MakeTempTable/CheckData uses exact Product.ProdName + SIZE and active Product. Packing matching reads Product only and writes web runtime mappings; native receipt/order/stock writers are not invoked.",
    "methods": [
      "MakeTempTable",
      "CheckData",
      "InsertMaster (not invoked)"
    ],
    "tables": [
      "Product (read only)",
      "OrderMaster (preserve)",
      "OrderDetail (preserve)",
      "ShipmentDetail (preserve)",
      "ProductStock (preserve)"
    ]
  },
  "requiredCommands": [
    "npm run test:erp-contract",
    "npm run test:nenova-dnspy-evidence",
    "npm run test:erp-manifest -- --changed-from origin/master",
    "npm run guard:erp-writes -- --changed-from origin/master",
    "npm run build"
  ]
}
