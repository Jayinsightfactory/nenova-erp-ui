  "businessIdentity": [
    "OrderYear",
    "OrderWeek",
    "CustKey",
    "ProdKey"
  ],
  "businessIdentityUse": "Packing product matching reads active Product identities only; country + source description maps to ProdKey in web runtime with CAS and actor history. No ERP writes. The feedback tab embeds the existing authenticated farm-quality page and delegates its existing read/write scope unchanged to farm-quality.json.",
  "webIdentity": [
    "recordKey",
    "revision",
    "authenticatedUserId"
  ],
  "actions": [
    {
      "name": "MATCH_ERP_PRODUCT",
      "orderDetail": "preserve",
      "shipmentDetail": "preserve",
      "stock": "preserve",
      "runtimeFile": "packing.erp-matches; authenticated CAS mapping history; Product SELECT only, no receipt/estimate mutations"
    },
    {
      "name": "REVIEW_EXTRACTION_EVIDENCE",
      "orderDetail": "preserve",
      "shipmentDetail": "preserve",
      "stock": "preserve",
      "runtimeFile": "none; local PDF evidence preview and editable GW/CW/freight confirmation; workbook audit sheet only, no ERP save"
    },
    {
      "name": "PREVIEW_AND_COPY_RESULTS",
      "orderDetail": "preserve",
      "shipmentDetail": "preserve",
      "stock": "preserve",
      "runtimeFile": "none; browser-only notes, user-triggered clipboard window, no ERP receipt save"
    },
    {
      "name": "CONVERT_FILES",
      "orderDetail": "preserve",
      "shipmentDetail": "preserve",
      "stock": "preserve"
    },
    {
      "name": "SAVE_TEAM_STATE",
      "orderDetail": "preserve",
      "shipmentDetail": "preserve",
      "stock": "preserve",
      "runtimeFile": "versioned web-only team state and actor history"
    }
  ],
  "crossYearFixture": {
    "required": true,
    "description": "Checklist YYYY-MM-DD/month/year keys isolate 2025 and 2026; file conversion requires explicit year/week; no SQL master queries."
  },
  "requiredTestFiles": [
    "__tests__/importPackingAustraliaQuantity.test.js",
