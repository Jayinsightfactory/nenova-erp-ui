  "businessIdentity": ["OrderYear", "OrderWeek", "CustKey", "ProdKey"],
  "evidenceScope": { "orderYear": 2026, "majorWeeks": [22, 23, 24, 25, 26, 27, 28] },
  "crossYearFixture": { "required": true, "targetYear": 2026, "decoyYear": 2025, "implicitFallbacks": 0 },
  "workbook": {
    "mainSheet": "주차별 매출이익 보고서",
    "mainColumns": "B:U",
    "headerRow": 6,
    "bodyRows": "7:22",
    "totalRow": 23,
    "totalRatioCell": "U23",
    "noteCell": "B25",
    "helperSheetCount": 10,
    "historicalRows": { "22-27": "공제", "28": "국내" },
    "week24AdditionalSheet": "Sheet1"
  },
  "shipmentResolver": {
    "masterPredicates": ["ShipmentMaster.OrderYear=@yr", "ShipmentMaster.OrderWeek LIKE @pfx", "ShipmentMaster.OrderYearWeek=@yw", "ShipmentMaster.isFix=1", "ShipmentMaster.isDeleted=0"],
    "detailPredicates": ["ShipmentDetail.isFix=1", "ShipmentDetail.OutQuantity<>0"],
    "forbidden": ["same OrderWeek from another OrderYear", "unfixed ShipmentDetail", "report-side ERP write"]
  },
  "inventoryResolver": {
    "quantity": "same OrderYear + major, ProductStock exists, numeric subweek DESC, ProductStock row count DESC, StockKey DESC; StockMaster.isFix is diagnostic metadata and is never a FormStockView close filter",
    "price": "원본 workbook 수식 카테고리(콜롬비아 수국·카네이션·장미·루스커스·알스트로, 베트남)는 (Q×R+S×R+H)÷당주 매입수량×마지막 ProductStock 재고수량으로 평가한다. 그 밖은 1순위 exact OrderYear+OrderWeek+ProdKey VERIFIED WebStockPriceEvidence, 2순위 같은 scope·ProdKey·EstUnit의 사용자 확정 WebArrivalCostLine 품목별 수량가중평균, 3순위 2026-28차 이후 exact ProdKey+EstUnit의 버전관리 원본 재고잔량 catalog(원화 VAT 포함단가÷1.1 또는 호주 외화단가×원본 AUD 과세환율), 마지막으로 정확한 2026년 22~28차 원본 workbook F 셀(SHA+sheet+cell 고정)만 사용한다. catalog는 fuzzy 매칭·다른 연도·28차 이전에 적용하지 않는다. 명시적 샘플/SAMPLE 품목은 이 정확 근거가 없을 때만 같은 OrderYear+OrderWeek+StockKey와 동일 EstUnit의 비샘플 검증단가를 ProductStock 수량으로 가중평균하며 같은 Category를 우선한다. Product.Cost는 EXE의 현재 출고단가이므로 자동 확정과 추천에 사용하지 않는다. 평균원가 대상 외 신규 품목(호주 포함)은 정확 근거가 없을 때 같은 OrderYear+MajorWeek+ProdKey의 확정 분배에서 VAT 포함 Cost별 서로 다른 업체 수를 세고, 가장 많은 업체가 사용한 실제 Cost 하나를 우선 추천한 뒤 /1.1한다. 업체 수가 같을 때만 EstQuantity 합계가 큰 후보를 우선하며 모든 실제 Cost 후보를 선택 가능하게 표시한다. 후보 평균은 만들지 않고 사용자가 선택·저장한 해당 차수 evidence만 계산 원천으로 승격한다.",
    "beginning": "E는 현재 workbook E 리터럴을 읽지 않고 같은 OrderYear 직전 대차수 F를 동일 공식과 원천으로 재계산한다. 01차만 전년도 52차로 넘어간다. 26차 F와 27차 E의 베트남 불연속은 WORKBOOK_ANOMALY로 보존하되 자동 이월하지 않는다.",
    "missing": ["INPUT_REQUIRED", "UNVERIFIED"],
    "forbiddenFallbacks": ["WebProfitReport E/F final override", "current workbook E literal carry", "Product.Cost automatic final value", "recent WarehouseDetail cost", "명시적 샘플의 동일 스냅샷·동일 EstUnit 예외 외 category/global/unrelated average", "upload-only arrival auto-match", "unit-mismatched arrival cost", "hydrangea hardcode", "out-of-scope historical workbook", "previous-year stock except week 01 to prior-year 52", "StockMaster.isFix filtering"]
  },
  "runtimeDdl": "FORBIDDEN",
  "migration": "docs/migrations/2026-08-13_profit_report_evidence_rag.sql",
