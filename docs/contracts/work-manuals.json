{
  "id": "work-manuals",
  "title": "부서별 업무 매뉴얼(웹 전용 JSON 저장) 계약",
  "scope": [
    "pages/work/manuals.js",
    "pages/api/work/manuals.js",
    "lib/workManuals.js",
    "scripts/sync-orbit-manuals.js",
    "components/Layout.js"
  ],
  "businessIdentity": ["OrderYear", "OrderWeek", "CustKey", "ProdKey"],
  "actions": [
    { "name": "MANUAL_LIST_OWN_OR_ADMIN", "orderDetail": "preserve", "shipmentDetail": "preserve" },
    { "name": "MANUAL_EDIT_CONFIRM_FILE_ONLY", "orderDetail": "preserve", "shipmentDetail": "preserve" },
    { "name": "MANUAL_ICON_LAYOUT_PER_USER", "orderDetail": "preserve", "shipmentDetail": "preserve" },
    { "name": "MANUAL_DRAFT_SYNC_FROM_ORBIT", "orderDetail": "preserve", "shipmentDetail": "preserve" }
  ],
  "crossYearFixture": {
    "required": true,
    "description": "업무 매뉴얼은 ERP 원장을 읽거나 쓰지 않는다. 저장소는 data/work-manuals 의 JSON 파일뿐이며 MSSQL 연결을 열지 않는다. 차수·거래처·품목 키를 다루지 않으므로 연도 간 병합 문제가 없다."
  },
  "requiredTestFiles": [
    "__tests__/workManuals.test.js",
    "__tests__/nenovaSs3AdminAccess.test.js",
    "__tests__/erpContractManifest.test.js"
  ],
  "dnspyEvidence": {
    "required": true,
    "record": "docs/exe-golden/README.md",
    "source": "업무 매뉴얼은 nenova.exe 기능이 아닌 웹 전용 화면이며 ERP 테이블 side effect는 모두 preserve다.",
    "methods": [
      "NenovaWeb JWT userName/userId claim check (lib/workManuals.canView)",
      "File-only persistence under data/work-manuals (no SQL)"
    ],
    "tables": [
      "UserInfo (login source only; no write)",
      "OrderDetail (preserve)",
      "ShipmentDetail (preserve)"
    ]
  },
  "requiredCommands": [
    "npm run test:erp-contract",
    "npm run test:nenova-dnspy-evidence",
    "npm run guard:erp-writes -- --changed-from HEAD^",
    "npm run build"
  ]
}
