  "dnspyEvidence": {
    "required": true,
    "record": "docs/exe-golden/README.md",
    "source": "PM 사무실은 nenova.exe 기능이 아닌 웹 전용 파일 조회 기능이며 ERP 테이블 side effect는 모두 preserve다. 수신은 ORBIT_DRIVE_INGEST_TOKEN(서버 전용 토큰), 열람은 /my-work 와 같은 isOrbitReportViewer 게이트(404 은닉).",
    "methods": [
      "NenovaWeb JWT UserInfo.UserID claim check (lib/orbitReportAccess.isOrbitReportViewer)"
    ],
    "tables": [
      "UserInfo (login source only; no write)",
      "OrderDetail (preserve)",
      "ShipmentDetail (preserve)"
    ]
  },
