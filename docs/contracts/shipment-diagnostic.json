    {
      "name": "DISTRIBUTE_IMPORT_PREVIEW_FIXED_ALERT",
      "description": "엑셀 업로드 후 검증하기는 preview와 apply가 공유하는 확정 범위 판정 결과에 확정차단 행이 있으면 연도·세부차수·업체·품목·건수와 확정취소 후 재검증 안내를 즉시 표시한다.",
      "orderDetail": "preserve",
      "shipmentDetail": "preserve",
      "shipmentDate": "preserve",
      "shipmentFarm": "preserve",
      "estimate": "preserve",
      "stock": "preserve"
    },
    {
      "name": "DISTRIBUTE_IMPORT_FINAL_APPLY",
      "description": "명시된 연도·차수의 엑셀을 최종 분배표로 한 트랜잭션에 저장한다. 양수는 주문과 분배의 최종값으로 맞추고, 0·빈칸·행누락은 주문등록값을 보존하면서 분배만 0으로 처리한다. 파일 전체를 분배만 반영하는 별도 모드는 허용하지 않는다.",
      "orderDetail": "replace-positive_preserve-zero-blank-missing",
      "shipmentDetail": "set-final-nonnegative",
      "detailEffect": "set_final_positive_or_delete_distribution_on_zero_blank_missing",
      "shipmentDate": "follow_shipment_detail_quantity",
      "shipmentFarm": "preserve",
      "estimate": "preserve",
      "stock": "preserve",
      "batchAtomic": true,
      "yearRequired": true,
      "stalePreview": "block_entire_batch_on_unexpected_shipment_drift; active current-year orders are always preserved and their quantity drift does not block shipment final-state SET",
      "orderWritePolicy": "active current-year OrderDetail exists => preserve order and apply shipment only; no active order + positive shipment target => create positive order then apply shipment; zero target never creates or changes order",
      "fixedRow": "block_entire_batch",
      "verification": "shipment_final_quantity_and_date_before_commit; existing orders are quantity-preserved; newly required orders verify positive active-row existence only",
      "repeatSameUpload": "no_op",
      "shipmentOnly": "reject_global_mode",
      "blankCell": "preserve_order_set_distribution_zero",
      "missingRow": "preserve_order_set_distribution_zero",
      "explicitZero": "preserve_order_set_distribution_zero",
      "shipmentWithoutOrder": "include_in_preview_and_set_distribution_zero_when_in_file_scope"
    },
    {
      "name": "DISTRIBUTE_IMPORT_ROLLBACK",
      "description": "관리자가 불변 전후 스냅샷과 현재 원장을 대조한 뒤 업로드 한 건 전체를 적용 전 상태로 되돌린다. 업로드 이후 변경이 하나라도 있으면 전체를 중단한다.",
      "audit": "immutable_preserve_and_mark_rolled_back",
      "orderDetail": "decrease",
      "shipmentDetail": "decrease",
      "conflict": "abort_entire_batch",
      "orderHistory": "append",
      "shipmentHistory": "append",
      "batchAtomic": true,
      "authorization": "server_admin_required"
    }
