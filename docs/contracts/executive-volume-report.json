{
  "id": "executive-volume-report",
  "title": "대표 모바일 국가·품종별 차수 물량 보고서",
  "scope": [
    "lib/executiveVolumeReport.js",
    "pages/api/m/executive-volume.js",
    "pages/m/executive-volume.js",
    "pages/m/index.js",
    "styles/executive-volume.module.css",
    "__tests__/executiveVolumeReport.test.js"
  ],
  "businessIdentity": ["OrderYear", "OrderWeek", "CustKey", "ProdKey"],
  "actions": [
    { "name": "READ_EXECUTIVE_VOLUME_REPORT", "orderDetail": "preserve", "shipmentDetail": "preserve" },
    { "name": "EXPORT_EXECUTIVE_VOLUME_XLSX", "orderDetail": "preserve", "shipmentDetail": "preserve" }
  ],
  "crossYearFixture": {
    "required": true,
    "description": "2025/2026 같은 40-01은 별도 자료이며 전년 비교는 선택 연도에서 정확히 1년 전의 동일 OrderWeek만 사용한다. 직전 차수는 ViewOrder/ViewWarehouse/ViewShipment에 실제 존재하는 순서상 직전 차수다."
  },
  "requiredTestFiles": ["__tests__/executiveVolumeReport.test.js"],
  "dnspyEvidence": {
    "required": true,
    "record": "docs/exe-golden/FormProfitReport.md",
    "source": "Git에 기록된 FormProfitReport 및 FormStockView/FormWarehouseView 읽기 근거를 따른다. 보고서 계산·side-effect matrix는 docs/work-reports/2026-10-01_executive-volume-report.md에 기록했다. 주문·입고는 Product.OutUnit 단위 수량, 출고는 ViewShipment의 master/detail 확정 조건을 모두 적용한다. 이 변경 중 운영 DB 조회/쓰기는 실행하지 않았다.",
    "methods": ["FormProfitReport.GetData", "FormStockView.GetData", "FormWarehouseView.GetDetail"],
    "tables": ["ViewOrder", "ViewWarehouse", "ViewShipment", "Product", "ShipmentMaster", "ShipmentDetail"]
  },
  "preserves": ["OrderMaster", "OrderDetail", "ShipmentMaster", "ShipmentDetail", "ShipmentDate", "WarehouseMaster", "WarehouseDetail", "ProductStock", "StockHistory", "Estimate", "WebProfitReport"],
  "requiredCommands": [
    "node __tests__/executiveVolumeReport.test.js",
    "npm run test:erp-contract",
    "npm run test:nenova-dnspy-evidence",
    "npm run guard:erp-writes -- --changed-from HEAD^",
    "npm run build"
  ]
}
