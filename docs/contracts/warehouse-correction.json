{
  "id": "warehouse-correction",
  "title": "입고관리 농장 수정 및 선택 원장 파킹파일 교체",
  "scope": [
    "lib/warehouseCorrection.js",
    "lib/warehouseCorrectionPolicy.js",
    "components/WarehouseCorrection.js",
    "pages/api/warehouse/correction.js",
    "pages/incoming.js",
    "pages/import/tools.js",
    "lib/incomingWorkspaceNavigation.js",
    "__tests__/incomingWorkspaceNavigation.test.mjs",
    "__tests__/incomingQueryDateRange.test.js",
    "scripts/incoming-workspace-smoke.cjs",
    "__tests__/warehouseCorrection.test.mjs",
    "__tests__/warehouseCorrectionSql.test.mjs",
    "scripts/warehouse-correction-ui-smoke.cjs",
    "package.json",
    "__tests__/fixtures/warehouseCorrectionNative.sql",
    "lib/warehouseFarmChoices.js",
    "components/WarehouseFarmSelect.js",
    "__tests__/warehouseFarmChoices.test.mjs",
    "__tests__/warehouseFarmChoicesSql.test.mjs",
    "scripts/warehouse-farm-search-ui.cjs"
  ],
  "businessIdentity": [
    "OrderYear",
    "OrderWeek",
    "CustKey",
    "ProdKey"
  ],
  "warehouseIdentity": [
    "WarehouseKey",
    "OrderYear",
    "OrderWeek",
    "ProdKey"
  ],
  "actions": [
    {
      "name": "PREVIEW",
      "orderDetail": "preserve",
      "shipmentDetail": "preserve",
      "warehouse": "read-only"
    },
    {
      "name": "FARM",
      "orderDetail": "preserve",
      "shipmentDetail": "preserve",
      "warehouseMaster": "FarmName and audit fields only",
      "warehouseDetail": "preserve",
      "stock": "preserve"
    },
    {
      "name": "REPLACE",
      "orderDetail": "preserve",
      "shipmentDetail": "preserve",
      "warehouseMaster": "preserve identity and metadata; update FarmName and audit fields",
      "warehouseDetail": "replace only unlinked receipt",
      "stock": "delta Product.Stock + StockHistory; native current/future ProductStock recalculation"
    }
  ],
  "writes": [
    "WarehouseMaster",
    "WarehouseDetail",
    "Product",
    "StockHistory",
    "StockMaster",
    "ProductStock",
    "SystemActionLog"
  ],
  "preserves": [
    "OrderMaster",
    "OrderDetail",
    "ShipmentMaster",
    "ShipmentDetail",
    "ShipmentDate",
    "ShipmentFarm",
    "Estimate",
    "WebProfitReport",
    "FreightCost",
    "WebInvoiceOperation"
  ],
  "crossYearFixture": {
    "required": true,
    "description": "2025와 2026 동일 차수에서 명시 WarehouseKey+연도+차수만 교체. 2025 보존, 이후 연도 재고는 native cascade 후 음수 검사."
  },
  "dnspyEvidence": {
    "required": true,
    "record": "docs/exe-golden/WarehouseCorrection.md",
    "source": "actual dnSpy CLI FormWarehouseAdd/ExcelLoadingPackingList/FormWarehouseView and live SELECT-only SQL definitions",
    "methods": [
      "FormWarehouseAdd.btnSave_Click",
      "ExcelLoadingPackingList.InsertMaster",
      "FormWarehouseView.GetDetail"
    ],
    "tables": [
      "WarehouseMaster",
      "WarehouseDetail",
      "Product",
      "StockHistory",
      "ProductStock"
    ]
  },
  "requiredTestFiles": [
    "__tests__/warehouseCorrection.test.mjs",
    "__tests__/warehouseCorrectionSql.test.mjs",
    "__tests__/warehouseFarmChoices.test.mjs",
    "__tests__/warehouseFarmChoicesSql.test.mjs"
  ],
  "requiredCommands": [
    "npm run test:erp-contract",
    "npm run test:nenova-dnspy-evidence",
    "npm run test:erp-manifest -- --changed-from HEAD^",
    "npm run guard:erp-writes -- --changed-from HEAD^",
    "npm run build"
  ],
  "farmChoiceContract": {
    "source": "active Farm plus existing active receipt FarmName without a Farm master; archived master names excluded",
    "sharedHelper": "warehouseFarmChoicesSql",
    "consumers": [
      "GET choices",
      "correction preview/locked save",
      "approval read/locked final"
    ],
    "search": "case/whitespace insensitive substring; never auto-select or write",
    "receiptOnlyName": "valid only as WarehouseMaster.FarmName, never synthesize FarmKey or distribution candidates",
    "crossYear": "candidate names global; write scope remains WarehouseKey + explicit year/week",
    "plan": "docs/plans/incoming-farm-search-2026-11-18.md"
  },
  "requestHandoff": {
    "entry": "직접 수정→영업지원 요청으로 전환",
    "preserves": [
      "WarehouseKey",
      "OrderYear",
      "OrderWeek",
      "mode",
      "farmName",
      "items",
      "reason"
    ],
    "writeBeforeApproval": "기존 approval create/submit만 사용; ERP 원장 변경 없음",
    "fixedShipment": "요청 등록을 막지 않음; 농장-only 확정 보존, 수량변경은 기존 최종승인 원자 처리",
    "retry": "동일 operationId 생성 재확인, 생성된 draft의 현재 revision으로 submit"
  }
}
