{
  "id": "moyi-drive-admin",
  "title": "MOYI Drive 관리자 화면과 연결 대기 권한 계약",
  "scope": [
    "pages/integrations/moyi-drive.js",
    "pages/api/moyi/drive-admin.js",
    "pages/api/moyi/drive-preview/[fileId].js",
    "lib/moyiDriveAdmin.js",
    "lib/moyiDriveGateway.js",
    "lib/moyiDriveViewModel.js",
    "scripts/verify-moyi-drive-integration.mjs",
    "scripts/verify-moyi-drive-http-e2e.mjs",
    "components/Layout.js",
    "components/moyiDrive/Button.js",
    "components/moyiDrive/FileRow.js",
    "components/moyiDrive/Input.js",
    "components/moyiDrive/PermissionRow.js",
    "components/moyiDrive/StatusBadge.js",
    "components/moyiDrive/StatusPanel.js",
    "components/moyiDrive/Tabs.js",
    "components/moyiDrive/Toolbar.js"
  ],
  "businessIdentity": ["OrderYear", "OrderWeek", "CustKey", "ProdKey"],
  "actions": [
    { "name": "DRIVE_LEDGER_READ_VIA_CONNECTION", "orderDetail": "preserve", "shipmentDetail": "preserve" },
    { "name": "DRIVE_IMAGE_PREVIEW_VIA_SHORT_LIVED_URL", "orderDetail": "preserve", "shipmentDetail": "preserve" },
    { "name": "DRIVE_PERMISSION_CHANGE_BLOCKED_PENDING_CORE", "orderDetail": "preserve", "shipmentDetail": "preserve" },
    { "name": "DRIVE_IDENTITY_CHANGE_BLOCKED_PENDING_CORE", "orderDetail": "preserve", "shipmentDetail": "preserve" }
  ],
  "crossYearFixture": {
    "required": true,
    "description": "현재 화면은 ERP 원장을 읽거나 쓰지 않는다. 향후 Nenova 업무 파일 연결 시 OrderYear와 OrderWeek가 모두 없는 링크는 거부하며 다른 연도의 같은 차수 자료와 권한을 합치지 않는다."
  },
  "requiredTestFiles": [
    "__tests__/moyiDriveAdmin.test.js",
    "__tests__/moyiDriveViewModel.test.js",
    "__tests__/moyiDriveLayoutContract.test.js",
    "__tests__/erpContractManifest.test.js"
  ],
  "dnspyEvidence": {
    "required": true,
    "record": "docs/exe-golden/README.md",
    "source": "MOYI Drive와 권한 화면은 nenova.exe 기능이 아닌 웹 전용 연결 대기 화면이며 ERP 테이블 side effect는 모두 preserve다.",
    "methods": [
      "NenovaWeb JWT UserInfo.UserID claim check",
      "MOYI Core permission write blocked until contract confirmation",
      "MOYI connection cookie forwarded server-side only to configured Drive root"
    ],
    "tables": [
      "UserInfo (login source only; no write)",
      "OrderDetail (preserve)",
      "ShipmentDetail (preserve)"
    ]
  },
  "requiredCommands": [
    "npm run test:erp-contract",
    "npm run test:nenova-dnspy-evidence",
    "npm run guard:erp-writes -- --changed-from HEAD^",
    "npm run build"
  ]
}
