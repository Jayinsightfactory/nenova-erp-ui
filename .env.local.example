DB_SERVER=sql16ssd-014.localnet.kr
DB_PORT=1433
DB_NAME=nenova1_nenova
DB_USER=nenova1_nenova
DB_PASSWORD=여기에_DB비밀번호_입력

JWT_SECRET=nenova2026secretkey

# nenovakakao Google Sheet 읽기 전용 연동
# KAKAO_SHEET_ID는 전체 URL 또는 spreadsheet id 둘 다 가능
KAKAO_SHEET_ID=1pXLVZqiMwWt6Vh0IhWwASBvgLtZqLnbHXMWqOLNwAXU
# Railway에는 서비스 계정 JSON 전체 또는 base64 값을 환경변수로 저장
GOOGLE_SERVICE_ACCOUNT_JSON=

# 과거 호환용 변수. 현재 주간 과세환율 공개 조회에는 이 값을 사용하거나 전송하지 않는다.
KCS_EXCHANGE_RATE_API_KEY=
# 관세청 과세환율 API 활성화 스위치 — 미설정이면 기본 활성(2026년 28차 이후 자동 조회, 시크릿 불필요).
# 담당자가 명시적으로 false를 넣은 경우에만 네트워크 호출 자체를 하지 않는다. 끄고 싶을 때만 아래 줄의
# 주석을 해제한다.
# KCS_TAXABLE_RATE_ENABLED=false
# 관세청 과세환율 조회 엔드포인트. 기본값은 공식 UNI-PASS 조회 URL이며, 보통 바꿀 필요 없다.
KCS_TAXABLE_RATE_BASE_URL=https://unipass.customs.go.kr/clip/com/bsopcomn/baseinfo/retrieveCOM0101049Q.do
# 관세청 과세환율 API 호출 타임아웃(ms). 기본 8000.
KCS_TAXABLE_RATE_TIMEOUT_MS=8000
# 관세청 과세환율 조회 결과 메모리 캐시 TTL(ms). 기본 21600000(6시간) — 같은 통화·신고일자는
# 이 시간 내 재조회 시 네트워크 호출 없이 캐시값을 돌려준다.
KCS_TAXABLE_RATE_TTL_MS=21600000
