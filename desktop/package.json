{
  "name": "nenova-desktop",
  "version": "1.3.11",
  "description": "Nenova 업무 탭과 창 관리 프로그램",
  "author": "Nenova",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "menu": "node scripts/generate-menu.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "electron scripts/smoke.cjs",
    "test:restore": "node scripts/verify-restore.cjs",
    "dist": "npm run menu && electron-builder --win nsis --x64 --publish never",
    "pack": "npm run menu && electron-builder --win --dir --x64",
    "test:updater": "electron scripts/updater-download-smoke.cjs",
    "test:exit": "node scripts/exit-probe.cjs"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.nenova.workspace",
    "productName": "Nenova Desktop",
    "artifactName": "Nenova-Desktop-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "preload.cjs",
      "bootstrap.cjs",
      "home-workspace.cjs",
      "shell/**/*",
      "assets/**/*",
      "package.json",
      "updater.cjs",
      "activity.cjs"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "네노바 업무",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/Jayinsightfactory/nenova-erp-ui/releases/latest/download"
    },
    "releaseInfo": {
      "releaseNotes": "업무 메뉴에 로그아웃·계정 변경 버튼을 추가했습니다.\n탭 닫기 확인창은 닫기가 기본 선택이며 Esc로 취소합니다.\n오늘의 내 업무 수정·보관 기능을 사용하려면 앱 1.3.11 설치 후 다시 로그인하세요."
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
