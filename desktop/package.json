{
  "name": "nenova-desktop",
  "version": "1.3.14",
  "description": "Nenova 업무 탭과 창 관리 프로그램",
  "author": "Nenova",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "menu": "node scripts/generate-menu.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "electron scripts/smoke.cjs",
    "test:restore": "node scripts/verify-restore.cjs",
    "dist": "npm run menu && electron-builder --win nsis --x64 --publish never",
    "pack": "npm run menu && electron-builder --win --dir --x64",
    "test:updater": "electron scripts/updater-download-smoke.cjs",
    "test:exit": "node scripts/exit-probe.cjs"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.nenova.workspace",
    "productName": "Nenova Desktop",
    "artifactName": "Nenova-Desktop-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "preload.cjs",
      "notes-preload.cjs",
      "bootstrap.cjs",
      "home-workspace.cjs",
      "shell/**/*",
      "assets/**/*",
      "package.json",
      "updater.cjs",
      "activity.cjs"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "네노바 업무",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/Jayinsightfactory/nenova-erp-ui/releases/latest/download"
    },
    "releaseInfo": {
      "releaseNotes": "오늘의 내 업무 메모장 창을 GPT 디자인 시안에 맞춰 새로 구성했습니다.\n진행률 원형 카드, 업무 카드, 빠른 추가, 알림 설정을 좁은 창에서 읽기 쉽게 표시합니다."
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
