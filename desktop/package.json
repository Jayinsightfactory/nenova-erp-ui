{
  "name": "nenova-desktop",
  "version": "1.3.23",
  "description": "Nenova 업무 탭과 창 관리 프로그램",
  "author": "Nenova",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "menu": "node scripts/generate-menu.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "electron scripts/smoke.cjs",
    "test:restore": "node scripts/verify-restore.cjs",
    "dist": "npm run menu && electron-builder --win nsis --x64 --publish never",
    "pack": "npm run menu && electron-builder --win --dir --x64",
    "test:updater": "electron scripts/updater-download-smoke.cjs",
    "test:exit": "node scripts/exit-probe.cjs"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.nenova.workspace",
    "productName": "Nenova Desktop",
    "artifactName": "Nenova-Desktop-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "account-favorites.cjs",
      "policy.cjs",
      "preload.cjs",
      "notes-preload.cjs",
      "bootstrap.cjs",
      "home-workspace.cjs",
      "pm-live.cjs",
      "shell/**/*",
      "assets/**/*",
      "package.json",
      "updater.cjs",
      "activity.cjs",
      "ai-bridge.cjs",
      "ai-bridge-mcp.cjs",
      "task-launcher.cjs",
      "lifecycle.cjs",
      "home-board.cjs",
      "company-calendar.cjs"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "네노바 업무",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/Jayinsightfactory/nenova-erp-ui/releases/latest/download"
    },
    "releaseInfo": {
      "releaseNotes": "회사 공통 일정 등록과 월간·주간 접기/열기를 추가했습니다. 홈은 기본으로 펼쳐지며 웹 개발요청 버튼이 상단에 있습니다. PM의 쉬운 오류 제목 표시도 유지합니다."
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
