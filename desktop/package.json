{
  "name": "nenova-desktop",
  "version": "1.3.81",
  "description": "Nenova 업무 탭과 창 관리 프로그램",
  "author": "Nenova",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "menu": "node scripts/generate-menu.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "electron scripts/smoke.cjs",
    "test:restore": "node scripts/verify-restore.cjs",
    "dist": "npm run menu && electron-builder --win nsis --x64 --publish never",
    "pack": "npm run menu && electron-builder --win --dir --x64",
    "test:updater": "electron scripts/updater-download-smoke.cjs",
    "test:exit": "node scripts/exit-probe.cjs"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.nenova.workspace",
    "productName": "Nenova Desktop",
    "artifactName": "Nenova-Desktop-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "account-favorites.cjs",
      "policy.cjs",
      "preload.cjs",
      "notes-preload.cjs",
      "bootstrap.cjs",
      "home-workspace.cjs",
      "pm-live.cjs",
      "admin-alerts.cjs",
      "alerts-preload.cjs",
      "shell/**/*",
      "assets/**/*",
      "package.json",
      "updater.cjs",
      "activity.cjs",
      "ai-bridge.cjs",
      "ai-bridge-mcp.cjs",
      "task-launcher.cjs",
      "lifecycle.cjs",
      "home-board.cjs",
      "flight-board.cjs",
      "flight-popup.cjs",
      "company-calendar.cjs",
      "windows-identity.cjs"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "네노바 업무",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/Jayinsightfactory/nenova-erp-ui/releases/latest/download"
    },
    "releaseInfo": {
      "releaseNotes": "출고분배 엑셀 업로드를 파일·반영 방식, 검증·승인·다운로드 순서로 정돈했습니다. 미매칭 확인창의 초점 복귀와 작은 화면 버튼 잘림을 보완했습니다."
    },
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "assets/icon.ico",
        "to": "nenova-taskbar.ico"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
