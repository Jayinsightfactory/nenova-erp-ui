    { "column": "H", "label": "그외통관비", "formula": "백상창고료+관세+선율공급가+월드운송공급가+한국방역공급가; 콜롬비아 4품목은 무게비율 배분", "workbookSources": ["그외통관비", "콜롬비아 1차", "콜롬비아 2차"], "resolver": "computeCustomsAndForwarding", "automatic": "mixed-external-components" },
    { "column": "I", "label": "매출원가", "formula": "E+G+H-F", "workbookSources": ["주차별 매출이익 보고서.E:G,H,F"], "resolver": "computeProfitRow", "automatic": true },
    { "column": "J", "label": "매출이익", "formula": "C-I", "workbookSources": ["주차별 매출이익 보고서.C,I"], "resolver": "computeProfitRow", "automatic": true },
