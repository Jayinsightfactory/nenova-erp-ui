    { "column": "L", "label": "불량금액", "formula": "불량차감 공급가액 합계", "workbookSources": ["불량차감"], "resolver": "estimateByCategory EstimateType=불량차감", "automatic": true },
    { "column": "M", "label": "불량율", "formula": "-L/C", "workbookSources": ["주차별 매출이익 보고서.L,C"], "resolver": "computeProfitRow", "automatic": true },
    { "column": "N", "label": "순수매출액", "formula": "판매현황 공급가액 합계", "workbookSources": ["판매현황"], "resolver": "salesByCategory confirmed ShipmentDetail.Amount", "automatic": true },
    { "column": "O", "label": "그 외 매출액", "formula": "불량차감 외 Estimate 공급가액 합계", "workbookSources": ["그 외 매출액"], "resolver": "estimateByCategory non-defect Estimate.Amount", "automatic": true },
