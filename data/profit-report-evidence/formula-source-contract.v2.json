    { "column": "S", "label": "포워딩비용(USD)", "formula": "포워딩 원천 외화액 합계; 콜롬비아 4품목은 GW=CW이면 무게, 다르면 CBM 배분", "workbookSources": ["포워딩", "콜롬비아 1차", "콜롬비아 2차"], "resolver": "computeCustomsAndForwarding/forwarding ledger", "automatic": true },
