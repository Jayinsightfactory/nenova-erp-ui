    { "column": "F", "label": "기말상품재고액", "formula": "카테고리평균: (G+H)/매입수량*재고수량; 그 외: 품목별 확정단가*재고수량", "workbookSources": ["재고잔량"], "resolver": "computeCategoryAverageInventoryValue or verified item-price evidence", "automatic": true },
